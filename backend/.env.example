# ---- Database (PostgreSQL, via Prisma) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/first_faith?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/first_faith?schema=public"

# ---- Auth ----
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
UPLOADS_DIR="./uploads/products"

# ---- Unified App Deployment ----
PORT=4000
NODE_ENV=production
# FRONTEND_URL is optional in unified deployment because frontend and API share the same origin.
# FRONTEND_URL="http://localhost:4000"

# ---- Razorpay ----
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ---- Future: Stripe (kept modular, not required for launch) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"


# ---- Email Dispatch (Gmail SMTP primary / Resend fallback) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=firstfaithservices@gmail.com
SMTP_PASS="your-16-character-google-app-password"
EMAIL_FROM=firstfaithservices@gmail.com
ADMIN_EMAIL=officialfirstfaith@gmail.com

# Resend API (optional fallback)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="First Faith <onboarding@resend.dev>"
ADMIN_ALERT_EMAIL="officialfirstfaith@gmail.com"
