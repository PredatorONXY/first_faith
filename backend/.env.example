# ---- Database (Supabase Postgres, via Prisma) ----
# Get this from Supabase project settings → Database → Connection string (use the "pooled" URI for serverless hosts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ---- Supabase ----
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # backend only — never expose to frontend
SUPABASE_JWT_SECRET="your-jwt-secret"              # used to verify tokens issued by Supabase Auth

# ---- App ----
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000" # used for CORS allow-list

# ---- Razorpay ----
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ---- Future: Stripe (kept modular, not required for launch) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
