# ---- Backend API ----
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ---- Supabase (public keys only — safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---- Razorpay (public key only — safe for the browser, used by checkout.js) ----
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"

# Never put SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET, or any other
# private credential in this file or anywhere under frontend/ — those live
# only in backend/.env.
