# ---- Unified API Configuration ----
# In the browser, requests route to "/api" (same origin) served by the unified single application.
NEXT_PUBLIC_API_URL="/api"
# Internal URL used by Next.js server components during SSR (defaults to http://127.0.0.1:PORT/api automatically):
INTERNAL_API_URL="http://127.0.0.1:4000/api"

# ---- Razorpay (public key only — safe for the browser, used by checkout.js) ----
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"

# Never put DATABASE_URL, DIRECT_URL, JWT_SECRET, RAZORPAY_KEY_SECRET, or any other
# private credential in this file or anywhere under frontend/ — those live
# only in backend/.env.
